  "services": {
    "set_program": {
      "name": "Set program",
      "description": "Select a washing machine program and optionally its temperature, spin speed, soiling and extras, and start it.",
      "fields": {
        "program": {
          "name": "Program",
          "description": "Program name (e.g. Cottons) or numeric program id."
        },
        "temperature": {
          "name": "Temperature",
          "description": "Wash temperature in °C. Use 0 for cold. Eco variants are separate values, see the eco field."
        },
        "eco": {
          "name": "Eco",
          "description": "Use the eco variant of the temperature, when the program offers one."
        },
        "spin_speed": {
          "name": "Spin speed",
          "description": "Spin speed in rpm. Use 0 for no spin."
        },
        "soiling": {
          "name": "Soiling",
          "description": "Soiling level 1-3 of the load. Which levels are offered depends on the program."
        },
        "extras": {
          "name": "Extras",
          "description": "Extras to switch on; every other extra that can be set from the app is switched off."
        },
        "start": {
          "name": "Start",
          "description": "Start the wash after setting it. This cannot be undone from Home Assistant and uses up the armed Mobile Start — re-arm Mobile Start at the machine for the next cycle."
        }
      }
    }
