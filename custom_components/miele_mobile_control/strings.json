          "email": "Email address",
          "password": "Password",
          "country": "Country code"
        },
        "data_description": {
          "email": "The e-mail address of the Miele account",
          "password": "The account password",
          "country": "Two-letter country code of the account, e.g. NL, DE, GB"
        }
      },
      "reauth_confirm": {
        "title": "Renew Miele credentials",
        "description": "The Miele cloud no longer accepts the stored password for {email}. Enter the password of that account again.",
